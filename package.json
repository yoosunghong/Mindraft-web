{
  "name": "mindraft-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:client": "esbuild client/firebase-auth.js --bundle --format=iife --target=es2022 --minify --outfile=public/firebase-auth.js",
    "prestart": "npm run build:client",
    "predev": "npm run build:client",
    "test": "node --test test/*.test.js",
    "test:public": "node test/public-smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
